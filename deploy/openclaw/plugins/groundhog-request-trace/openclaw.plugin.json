{
  "id": "groundhog-request-trace",
  "name": "Groundhog request trace",
  "description": "Writes local JSONL request, LLM-call, and tool-call spans for every OpenClaw agent run.",
  "activation": { "onStartup": true, "onConfigPaths": ["plugins.entries.groundhog-request-trace"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "logDir": { "type": "string" },
      "retentionDays": { "type": "integer", "minimum": 1 }
    }
  }
}
